{
  "manifest_version": 3,
  "name": "Novel to EPUB (wtr-lab & more)",
  "version": "1.2.1",
  "description": "Download novels as EPUB. Full wtr-lab support (Web / Web+ / AI translation, exact illustrations) plus a generic extractor for other sites.",
  "action": {
    "default_title": "Novel to EPUB"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://wtr-lab.com/*",
    "https://img.wtr-lab.com/*",
    "https://translate-pa.googleapis.com/*",
    "<all_urls>"
  ]
}

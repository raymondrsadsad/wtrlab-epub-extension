{
  "manifest_version": 3,
  "name": "Novel to EPUB (wtr-lab & more)",
  "version": "1.17.0",
  "description": "Download novels as EPUB. Full wtr-lab support (Web / Web+ / AI translation, exact illustrations) plus a generic extractor for other sites.",
  "action": {
    "default_title": "Novel to EPUB",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "adapters/layout.js",
        "webwidget.js"
      ],
      "css": [
        "webwidget.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "adapters/registry.js",
        "adapters/wtrlab.js",
        "adapters/kakuyomu.js",
        "adapters/generic.js",
        "adapters/translate.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://wtr-lab.com/*",
    "https://img.wtr-lab.com/*",
    "https://translate-pa.googleapis.com/*",
    "<all_urls>"
  ]
}
